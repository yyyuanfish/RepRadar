# Local open-source model (no API key). First run: ollama pull qwen3:1.7b
ENABLE_LIVE_LLM=true
LLM_PROVIDER=ollama
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen3:1.7b

# For a deployed site, use an approved reachable model server instead.
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=https://your-approved-server.example/v1
# LLM_MODEL=your-model-id
# LLM_API_KEY=your-server-only-key
# ENABLE_LIVE_LLM=false restores source-excerpt mode.
